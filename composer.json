{
    "name": "cooolinho/filament-mailbox",
    "description": "IMAP, Microsoft Graph and Gmail API mailbox integration for Filament v5.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "imap",
        "microsoft-graph",
        "gmail",
        "oauth2",
        "mailbox"
    ],
    "authors": [
        {
            "name": "cooolinho"
        }
    ],
    "require": {
        "php": "^8.2",
        "directorytree/imapengine": "^1.25",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/html-sanitizer": "^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pulse": "^1.8",
        "laravel/scout": "^10.12",
        "open-telemetry/sdk": "^1.15",
        "orchestra/testbench": "^11.2"
    },
    "suggest": {
        "laravel/pulse": "Sync duration and failure cards for the Pulse dashboard (^1.8).",
        "open-telemetry/sdk": "OpenTelemetry spans for synchronisation runs (^1.15), with an exporter such as open-telemetry/exporter-otlp.",
        "laravel/scout": "Search through any Scout engine (Typesense, Algolia, ...) with the \"scout\" search engine (^10.12)."
    },
    "autoload": {
        "psr-4": {
            "Cooolinho\\FilamentMailbox\\": "src/",
            "Cooolinho\\FilamentMailbox\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cooolinho\\FilamentMailbox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cooolinho\\FilamentMailbox\\FilamentMailboxServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
